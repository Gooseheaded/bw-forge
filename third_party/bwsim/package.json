{
  "name": "bwsim-wasm-node",
  "version": "0.1.1",
  "type": "module",
  "description": "Headless Node.js wrapper for CWAL's bwsim WebAssembly engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "bwsim-smoke": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/patch-unit-instance-id.mjs",
    "provenance.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "example": "npm run build && node dist/cli.js",
    "patch:unit-id": "node scripts/patch-unit-instance-id.mjs",
    "smoke": "npm run build && node dist/cli.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
