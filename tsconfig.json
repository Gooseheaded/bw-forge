{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "bun"
    ]
  },
  "include": [
    "apps/cli/src/**/*.ts",
    "third_party/bwsim/dist/**/*.d.ts",
    "packages/schemas/src/**/*.ts"
  ]
}
