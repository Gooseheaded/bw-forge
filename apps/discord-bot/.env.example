DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_GUILD_ID=123456789012345678
DISCORD_PARENT_CHANNEL_IDS=123456789012345678
DISCORD_AUTHORIZED_ROLE_IDS=123456789012345678
BW_FORGE_LLM_PROVIDER=openai
# To use OpenRouter instead, set BW_FORGE_LLM_PROVIDER=openrouter,
# LLM_API_KEY to your OpenRouter key, and LLM_MODEL to its provider/model ID.
LLM_API_KEY=
LLM_MODEL=your-enabled-model-id
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_BUDGET=24000
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_CONCURRENT_TURNS=4
MAX_MESSAGES_QUEUED_PER_THREAD=32
DISCORD_BOT_DATABASE_PATH=./data/bot.sqlite
# Absolute deployed application root used to locate Corpus v2 Python/screp helpers.
# BW_FORGE_REPO_ROOT=/srv/bw-forge/app
# Replay ingestion (M2). Keep corpus databases separate from the bot database.
# JSON object: each entry requires name, database, corpus_root, and access.
BW_FORGE_CORPORA_JSON={}
# Omit the upload target/readable list until corpora above are configured.
# BW_FORGE_DEFAULT_UPLOAD_CORPUS=community
# BW_FORGE_READABLE_CORPORA=pro,community
BW_FORGE_MAX_REPLAY_BYTES=67108864
BW_FORGE_MAX_REPLAY_DOWNLOADS=2
BW_FORGE_MAX_PENDING_REPLAYS_PER_SESSION=8
BW_FORGE_REPLAY_DOWNLOAD_TIMEOUT_MS=120000
BW_FORGE_REPLAY_POLL_INTERVAL_MS=5000
BW_FORGE_REPORT_DELIVERY_RETRIES=5
# Optional; omit for models without temperature support.
# BW_FORGE_LLM_TEMPERATURE=0.7
