[Unit]
Description=BW Forge Corpus v2 MCP HTTP server
After=local-fs.target
PartOf=bw-forge.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@APP_ROOT@
EnvironmentFile=@ENV_FILE@
ExecStart=@BUN_EXECUTABLE@ @CLI_ENTRYPOINT@ mcp --db ${BW_FORGE_DB} --transport http --host ${BW_FORGE_MCP_HOST} --port ${BW_FORGE_MCP_PORT} --path ${BW_FORGE_MCP_PATH}
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bw-forge-mcp
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
CapabilityBoundingSet=
RestrictSUIDSGID=true
